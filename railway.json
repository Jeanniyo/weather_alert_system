{
  "$schema": "https://railway.app/railway.schema.json",
  
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt"
  },
  
  "deploy": {
    "startCommand": "python weather_alert_runner.py"
  },

  "cron": [
    {
      "command": "python weather_alert_runner.py",
      "schedule": "0 * * * *",
      "name": "weather-hourly-alert"
    }
  ]
}
