# ============================================================
# .env.example — Weather Alert System
# Copy this file to .env and fill in YOUR real values.
# ⚠️  NEVER commit the real .env file to GitHub!
# ============================================================

# ── Weather Source ──────────────────────────────────────────
# Get your free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
CITY=Kigali,RW

# ── Gmail SMTP ──────────────────────────────────────────────
# Use a Gmail App Password (NOT your regular Gmail password).
# Enable at: Google Account → Security → 2-Step Verification → App Passwords
GMAIL_ADDRESS=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# ── Alert Thresholds ────────────────────────────────────────
RAINFALL_MM_THRESHOLD=10.0        # mm to trigger flood alert
EMERGENCY_WIND_MS=12.0            # m/s to trigger storm alert
EMERGENCY_TEMP_C=40.0             # °C to trigger heat emergency
EMERGENCY_COOLDOWN_HOURS=3        # hours before re-sending same alert

# ── File Paths ──────────────────────────────────────────────
CONTACTS_CSV=contacts.csv
EMERGENCY_STATE_FILE=emergency_state.json
